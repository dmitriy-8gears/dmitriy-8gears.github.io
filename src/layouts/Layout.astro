---
import "../styles/global.css";
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
const { title } = Astro.props;
---

<html lang="en">
<head>
    <BaseHead title={title}/>
</head>
<body class="bg-zinc-800 text-neutral-50 font-roboto font-light italic">
    <main class="flex justify-center items-center md:min-h-150" style="text-align: center;">
        <div class="w-full md:w-md bg-zinc-900 rounded-3xl animate__animated animate__fadeIn">
            <slot />
        </div>
    </main>
    <Footer />
</body>
</html>